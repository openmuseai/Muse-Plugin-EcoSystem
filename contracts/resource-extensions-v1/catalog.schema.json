{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resource Extensions v1 catalog",
  "type": "object",
  "required": [
    "profile",
    "extensions"
  ],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "openmuse-resource-extensions/1"
    },
    "extensions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tool",
          "mediaTypes",
          "width",
          "height"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]{1,80}$"
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "mediaTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "width": {
            "type": "integer",
            "minimum": 200,
            "maximum": 480
          },
          "height": {
            "type": "integer",
            "minimum": 48,
            "maximum": 180
          },
          "resourceTools": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "default": [],
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
