{
  "profile": "openmuse-capabilities/1",
  "contract": {
    "id": "https://plugins.openmuseai.com/contracts/genoffice/slides-read/v1",
    "version": "1.0.0",
    "title": "GenOffice Slides · file snapshots",
    "mediaType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
    "operations": {
      "readSnapshot": "slides_read_snapshot"
    },
    "tools": [
      "slides_read_snapshot"
    ],
    "semantics": "Immutable authorized file snapshot, not the unsaved active editor. Zero-based slide indices."
  },
  "tools": [
    {
      "name": "slides_read_snapshot",
      "description": "Read plain text and notes from an authorized PPTX file using the original GenOffice engine. This does not read unsaved editor changes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 94371840,
            "format": "base64",
            "contentEncoding": "base64",
            "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$",
            "contentMediaType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
          },
          "name": {
            "type": "string",
            "maxLength": 180
          }
        },
        "required": [
          "content"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "pageCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "text",
              "no-text-layer"
            ]
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "index",
                "id",
                "text",
                "notes"
              ],
              "additionalProperties": false
            }
          },
          "source": {
            "type": "string",
            "const": "genoffice-pptx-engine"
          }
        },
        "required": [
          "name",
          "revision",
          "pageCount",
          "status",
          "pages",
          "source"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    }
  ]
}
