{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenMuse DevKit Desktop lock v1",
  "type": "object",
  "required": [
    "format",
    "host",
    "dependencies"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "openmuse-devkit-lock/1"
    },
    "host": {
      "type": "object",
      "required": [
        "implementation"
      ],
      "properties": {
        "implementation": {
          "type": "object",
          "required": [
            "version",
            "buildSha256"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "buildSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "alias",
          "provider",
          "contract"
        ],
        "additionalProperties": false,
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,40}$"
          },
          "provider": {
            "type": "object",
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "contract": {
            "type": "object",
            "required": [
              "id",
              "version",
              "title",
              "mediaType",
              "operations",
              "tools"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uri"
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "title": {
                "type": "string"
              },
              "mediaType": {
                "type": "string"
              },
              "operations": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true
              },
              "semantics": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
