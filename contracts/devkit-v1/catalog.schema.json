{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenMuse public capability catalog v1",
  "type": "object",
  "required": [
    "profile",
    "contracts"
  ],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "openmuse-capabilities/1"
    },
    "contracts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "title",
          "mediaType",
          "operations",
          "tools"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "title": {
            "type": "string"
          },
          "mediaType": {
            "type": "string"
          },
          "operations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true
          },
          "semantics": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
