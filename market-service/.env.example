# Standalone SQLite/files local mode
MARKET_LISTEN=127.0.0.1:8787
MARKET_PUBLIC_ORIGIN=http://127.0.0.1:8787
MARKET_DATABASE_URL=sqlite://market.db?mode=rwc
MARKET_STORAGE_BACKEND=files
MARKET_STORAGE_DIR=./data/packages
MARKET_DEVELOPER_TOKEN=replace-for-local-development
MARKET_REVIEWER_TOKEN=replace-for-local-review
MARKET_DEVELOPER_NAMESPACE=io.openmuse

# Production-shaped local stack (docker compose up -d)
# MARKET_DATABASE_URL=postgres://plugin_market:local-market-password@127.0.0.1:15432/plugin_market
# MARKET_STORAGE_BACKEND=s3
# MARKET_S3_BUCKET=muse-plugin-artifacts
# MARKET_S3_ENDPOINT=http://127.0.0.1:19000
# MARKET_S3_AUTO_CREATE_BUCKET=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=market-local
# AWS_SECRET_ACCESS_KEY=market-local-password
