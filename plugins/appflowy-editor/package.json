{
  "name":"@openmuse/appflowy-editor-plugin",
  "version":"0.1.0",
  "private":true,
  "type":"module",
  "scripts":{
    "build":"esbuild src/mcp_server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs",
    "build:http":"esbuild src/http_server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/http.mjs",
    "build:web":"cd web && flutter build web --release --no-wasm-dry-run --base-href /editor/",
    "build:all":"npm run build && npm run build:http && npm run build:web",
    "test":"node --import tsx --test test/*.test.ts"
  },
  "dependencies":{"@modelcontextprotocol/server":"^2.3.1","@modelcontextprotocol/node":"^2.1.1","zod":"^4.6.7"},
  "devDependencies":{"@modelcontextprotocol/client":"^2.3.1","@types/node":"^24.10.1","esbuild":"^0.28.2","tsx":"^4.21.0","typescript":"^5.9.3"}
}
