{
  "profile": "openmuse-word-shortcuts/1",
  "bindings": [
    {"platform": "desktop", "keys": "Primary+O", "command": "word.file.open"},
    {"platform": "desktop", "keys": "Primary+S", "command": "word.file.save"},
    {"platform": "desktop", "keys": "Primary+Z", "command": "word.edit.undo"},
    {"platform": "desktop", "keys": "Primary+Shift+Z", "command": "word.edit.redo"},
    {"platform": "desktop", "keys": "Primary+B", "command": "word.format.bold"},
    {"platform": "desktop", "keys": "Primary+I", "command": "word.format.italic"},
    {"platform": "desktop", "keys": "Primary+U", "command": "word.format.underline"},
    {"platform": "web", "keys": "Primary+S", "command": "word.file.save"},
    {"platform": "web", "keys": "Primary+B", "command": "word.format.bold"},
    {"platform": "web", "keys": "Primary+I", "command": "word.format.italic"}
  ]
}
