{
  "profile": "openmuse-word-product/1",
  "id": "io.openmuse/word",
  "version": "0.1.22",
  "displayName": "Word",
  "documentFormats": [
    "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
  ],
  "requires": {
    "wordApiMajor": 1,
    "editorSurfaceMajor": 2
  },
  "resources": {
    "commands": "product/commands.json",
    "ribbon": "product/ribbon.json",
    "menus": "product/menus.json",
    "chrome": "product/chrome.json",
    "icons": "product/icons.json",
    "shortcuts": "product/shortcuts.json",
    "features": "product/features.json",
    "templates": [
      "product/templates/meeting-notes.json",
      "product/templates/report.json"
    ],
    "fonts": "product/fonts/catalog.json",
    "extensions": [
      "product/extensions/word-count.json"
    ]
  }
}
