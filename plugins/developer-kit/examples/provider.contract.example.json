{
  "formatVersion": "1.0-draft",
  "exampleOnly": true,
  "contractId": "https://contracts.openmuseai.com/genoffice/slides/v1",
  "version": "1.0.0",
  "publisher": "io.openmuse",
  "description": "Proposed public Slides API subset. This is an ecosystem contract descriptor, not a base MCP manifest. The full v1 must also define notes, state and navigation before the project example can resolve.",
  "operations": [
    {
      "operation": "readSnapshot",
      "tool": "slides_read_snapshot",
      "permissions": ["resource.read"],
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object", "additionalProperties": false,
        "properties": {}, "required": []
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object", "additionalProperties": false,
        "required": ["revision", "slides"],
        "properties": {
          "revision": {"type": "string", "minLength": 1},
          "slides": {"type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["slideId", "index", "text"],
            "properties": {
              "slideId": {"type": "string", "minLength": 1},
              "index": {"type": "integer", "minimum": 0},
              "text": {"type": "string"}
            }
          }}
        }
      }
    },
    {
      "operation": "getPreview",
      "tool": "slides_get_preview",
      "permissions": ["resource.preview"],
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object", "additionalProperties": false,
        "required": ["slideId", "revision", "maxWidth"],
        "properties": {
          "slideId": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1},
          "maxWidth": {"type": "integer", "minimum": 64, "maximum": 2048}
        }
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object", "additionalProperties": false,
        "required": ["resource"],
        "properties": {"resource": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "uri", "name", "mimeType"],
          "properties": {
            "type": {"const": "resource_link"},
            "uri": {"type": "string", "format": "uri"},
            "name": {"type": "string", "minLength": 1},
            "mimeType": {"enum": ["image/png", "image/jpeg"]}
          }
        }}
      }
    }
  ]
}
