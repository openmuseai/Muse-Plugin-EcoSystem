{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openmuseai.com/devkit/project/v1.json",
  "title": "DevKit development project draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "project", "host", "targets", "capabilities", "features", "execution"],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "formatVersion": {"const": "1.0-draft"},
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "pluginId"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "pluginId": {"type": "string", "pattern": "^[a-z0-9.-]+/[a-z0-9-]+$"}
      }
    },
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["channel", "version"],
      "properties": {
        "channel": {"enum": ["release", "development"]},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "targets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["macos-aarch64", "macos-x86_64", "windows-x86_64", "linux-x86_64", "android-aarch64", "ios-aarch64", "web"]}
    },
    "capabilities": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
      "additionalProperties": {"$ref": "#/$defs/capability"}
    },
    "features": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
      "additionalProperties": {"$ref": "#/$defs/feature"}
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["runner", "cloudSourceUpload"],
      "properties": {
        "runner": {"enum": ["local", "remote", "select-at-run"]},
        "cloudSourceUpload": {"enum": ["deny", "ask"]}
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "version", "operations"],
      "properties": {
        "contract": {"type": "string", "format": "uri"},
        "version": {"type": "string", "minLength": 1},
        "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "preferredProvider": {"type": "string", "pattern": "^[a-z0-9.-]+/[a-z0-9-]+$"}
      }
    },
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "allOf", "resources"],
      "properties": {
        "required": {"type": "boolean"},
        "allOf": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
        "resources": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "mediaType"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "mediaType": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
