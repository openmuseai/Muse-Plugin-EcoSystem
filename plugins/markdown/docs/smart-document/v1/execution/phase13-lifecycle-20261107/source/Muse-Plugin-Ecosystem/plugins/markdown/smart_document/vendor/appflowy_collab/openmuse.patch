+
+// OpenMuse compatibility: Yrs 0.23.5 requires an explicit clock on wasm.
+#[cfg(target_arch = "wasm32")]
+fn new_awareness(doc: yrs::Doc) -> yrs::sync::Awareness {
+  yrs::sync::Awareness::with_clock(doc, || js_sys::Date::now() as u64)
+}
