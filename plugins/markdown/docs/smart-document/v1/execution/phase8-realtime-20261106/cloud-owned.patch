+/// Authenticate the presence slot and actor without changing its Yrs clock.
+fn normalize_awareness(
+  update: &mut AwarenessUpdate,
+  client_id: ClientID,
+  uid: i64,
+) -> Result<(), AppError> {
+  update.clients.retain(|id, _| *id == client_id);
+  if update.clients.len() > 1 {
+    return Err(AppError::InvalidRequest(
+      "Invalid awareness ownership".into(),
+    ));
+  }
+  for entry in update.clients.values_mut() {
+    if entry.json.as_ref() == "null" {
+      continue;
+    }
+    if entry.json.len() > 16 * 1024 {
+      return Err(AppError::InvalidRequest("Awareness too large".into()));
+    }
+    let mut state: serde_json::Value = serde_json::from_str(&entry.json)
+      .map_err(|_| AppError::InvalidRequest("Invalid awareness state".into()))?;
+    let map = state
+      .as_object_mut()
+      .ok_or_else(|| AppError::InvalidRequest("Awareness must be an object".into()))?;
+    map.insert(
+      "actor".into(),
+      serde_json::json!({"uid":uid.to_string(), "clientId":client_id.to_string()}),
+    );
+    entry.json = Arc::from(state.to_string());
+  }
+  Ok(())
+}
+
+#[cfg(test)]
+mod ownership_tests {
+  use super::*;
+  use yrs::sync::awareness::AwarenessUpdateEntry;
+  #[test]
+  fn awareness_preserves_clock_owns_only_authenticated_slot_and_overwrites_actor_claims() {
+    let mut update = AwarenessUpdate {
+      clients: HashMap::from([
+        (
+          7,
+          AwarenessUpdateEntry {
+            clock: 3,
+            json: Arc::from(r#"{"actor":{"uid":"forged"},"selection":null}"#),
+          },
+        ),
+        (
+          8,
+          AwarenessUpdateEntry {
+            clock: 99,
+            json: Arc::from(r#"{"actor":{"uid":"peer"}}"#),
+          },
+        ),
+      ]),
+    };
+    normalize_awareness(&mut update, 7, 42).unwrap();
+    assert_eq!(update.clients.len(), 1);
+    assert_eq!(update.clients[&7].clock, 3);
+    let state: serde_json::Value = serde_json::from_str(&update.clients[&7].json).unwrap();
+    assert_eq!(state["actor"]["uid"], "42");
+    assert_eq!(state["actor"]["clientId"], "7");
+    assert_eq!(state["selection"], serde_json::Value::Null);
+  }
+}
