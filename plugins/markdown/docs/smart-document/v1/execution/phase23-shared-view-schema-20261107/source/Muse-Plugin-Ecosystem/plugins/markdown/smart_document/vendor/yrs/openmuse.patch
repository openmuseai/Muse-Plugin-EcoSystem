+#[cfg(test)]
+mod muse_gc_prefix_tests {
+    use crate::{DeleteSet, Doc, Map, MapPrelim, Options, Transact, ID};
+    #[test]
+    fn gc_prefix_does_not_skip_live_deletion_tail() {
+        let doc = Doc::with_options(Options {
+            client_id: 1,
+            ..Options::default()
+        });
+        let root = doc.get_or_insert_map("root");
+        root.insert(
+            &mut doc.transact_mut(),
+            "gone",
+            MapPrelim::from([("child", 1)]),
+        );
+        root.remove(&mut doc.transact_mut(), "gone");
+        root.insert(&mut doc.transact_mut(), "live", 2);
+        let mut deletes = DeleteSet::new();
+        deletes.insert(ID::new(1, 1), 2);
+        doc.transact_mut().apply_delete(&deletes);
+        assert!(root.get(&doc.transact(), "live").is_none());
+    }
+}
